{
  "manifest_version": 3,
  "name": "Print X Article",
  "version": "1.0.0",
  "description": "Reformat an X article or thread into a clean print layout and send it to the print dialog.",
  "permissions": ["scripting"],
  "host_permissions": ["*://x.com/*", "*://twitter.com/*"],
  "action": {
    "default_title": "Print X Article",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "print-article": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Print the current X article"
    }
  }
}
